# Copy to .env and fill in. Never commit .env.

# Meta Model API (https://dev.meta.ai) — required
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Baseten (Muse Spark Open) — optional, only once your credit request is approved.
# Check the base URL against Baseten's quickstart before relying on it.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Which provider/model tags garments: "meta" or "baseten".
# Meta (Spark 1.3) won the Day-0 bake-off on crumpled cutouts; Baseten's Spark Open
# is used for text reasoning (outfit planning, check-ins, Ask) instead.
TAG_PROVIDER=meta
TAG_MODEL_META=muse-spark-1.3
TAG_MODEL_BASETEN=meta-models/muse-spark-open-1026

# Reasoning / judging and image models (Meta Model API)
REASON_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1

# Morning planner + evening check-in brain: "baseten" (Muse Spark Open, default) or "meta".
# Falls back to the other provider, then to rules, so the morning screen never breaks.
PLAN_PROVIDER=baseten
# Default location for the weather tool (Open-Meteo, no key needed). Toronto.
MONSTER_LAT=43.6532
MONSTER_LON=-79.3832
# Calendar for the planner: a .json (see fixtures/calendar_sample.json) or an .ics export.
MONSTER_CALENDAR=fixtures/calendar_sample.json
