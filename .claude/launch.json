{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "server.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "api-live",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "server.dev", "--live"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "web-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev:lan"],
      "port": 5173
    }
  ]
}
